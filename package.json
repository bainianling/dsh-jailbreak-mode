{
  "name": "@bainianling/dsh-jailbreak-mode",
  "description": "Logged per-agent jailbreak mode: automatic prompt-injection prefix for red-team safety evaluation",
  "version": "0.1.0-rc.13",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bainianling/dsh-jailbreak-mode.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-commands": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs-local": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "prepack": "npm run build"
  }
}
